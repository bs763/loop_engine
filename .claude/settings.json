{
  "permissions": {
    "allow": [
      "Bash(uv run:*)",
      "Bash(py:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run code/lib_status.py",
            "if": "Bash(*run_round_cli.py*)"
          }
        ]
      }
    ]
  }
}

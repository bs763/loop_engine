# 复制本文件为 .env 并填入你的值(.env 已 gitignore,不会上传)
# 用途:LLM 调用(生成+审查)与 alphalab 回测工具路径

# ---- LLM(默认全智谱 GLM;DeepSeek / Kimi 备用)----
GLM_API_KEY=你的-glm-key
GLM_MODEL=glm-4.5-flash
DEEPSEEK_API_KEY=sk-你的-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-pro
# Kimi(2026-08-19 试切后弃用:该 key 组织级 RPM=3 太慢;如换高速 key 可启用)
# KIMI_API_KEY=sk-你的-kimi-key
# KIMI_MODEL=kimi-k2.6

# 分配:生成端 / 审查端 各用哪家(glm / deepseek / mock;kimi 仅高速 key 可用)
GENERATION_PROVIDER=glm
REVIEW_PROVIDER=glm

# ---- alphalab 回测工具目录(换电脑改成你的路径)----
ALPHALAB_DIR=C:\path\to\因子检测操作步骤

# 累计退休制参数(2026-08-27;不设用默认;改后下一轮生效,无需重启)
MINED_TREE_CAP_PV=8
MINED_TREE_CAP_FUND=12
MINED_SUBTREE_CAP_PV=12
MINED_SUBTREE_CAP_FUND=16
